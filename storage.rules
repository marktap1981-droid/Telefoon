rules_version = '2';

// Firebase Storage-regels voor Voorraadbeheer (productfoto's).
// Plak deze in Firebase Console -> Storage -> Rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /households/{householdId}/product_images/{allPaths=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid in firestore.get(/databases/(default)/documents/households/$(householdId)).data.memberUids;
    }
  }
}
